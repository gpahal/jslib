{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./packages/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["*.config.ts", "*.config.mjs", "packages/*/tsdown.config.ts", "scripts/*.ts"]
}
