{
  "name": "jslib",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript libraries and config presets published as @gpahal/*",
  "homepage": "https://github.com/gpahal/jslib#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run build typecheck test typecheck-root typecheck-release lint-check lint-check-root fmt-check knip --continue=dependencies-successful",
    "clean": "rm -rf .turbo .eslintcache packages/*/build packages/*/.turbo packages/*/tests/tmp packages/*/*.tsbuildinfo packages/*/tests/*.tsbuildinfo packages/*/tests/*/*.tsbuildinfo packages/*/*.tgz",
    "cs": "changeset && changeset version",
    "cs-publish": "./scripts/verify-publish-branch.sh && pnpm pre-push </dev/null && ./scripts/verify-no-ignored-files.sh && turbo run build --force && ./scripts/verify-no-git-changes.sh && JSLIB_RELEASE=1 changeset publish --no-git-tag",
    "fmt": "prettier . --write",
    "fmt-check": "prettier . --check",
    "knip": "knip",
    "lint": "eslint . --cache",
    "lint-check": "turbo run lint-check lint-check-root",
    "lint-check-root": "eslint . --max-warnings 0 --ignore-pattern 'packages/**'",
    "lint-fix": "eslint . --cache --fix",
    "pre-commit": "pnpm build --output-logs=errors-only && pnpm exec lint-staged",
    "pre-push": "./scripts/verify-push-is-head.sh && ./scripts/verify-no-git-changes.sh && pnpm check && ./scripts/verify-no-git-changes.sh",
    "prepare": "simple-git-hooks",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck-root",
    "typecheck-release": "turbo run typecheck-release",
    "typecheck-root": "tsc"
  },
  "lint-staged": {
    "*": [
      "prettier --check --ignore-unknown",
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  }
}
