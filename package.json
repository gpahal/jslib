{
  "name": "jslib",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript libraries and config presets published as @gpahal/*",
  "homepage": "https://github.com/gpahal/jslib#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run build typecheck test test-recipes typecheck-root typecheck-release lint-check lint-check-root fmt-check knip --continue=dependencies-successful",
    "clean": "rm -rf .turbo .eslintcache packages/*/build packages/*/.turbo packages/*/tests/tmp packages/*/*.tsbuildinfo packages/*/tests/*.tsbuildinfo packages/*/tests/*/*.tsbuildinfo packages/*/*.tgz",
    "fmt": "prettier . --write",
    "fmt-check": "prettier . --check",
    "knip": "knip",
    "lint": "eslint . --cache",
    "lint-check": "turbo run lint-check lint-check-root",
    "lint-check-root": "eslint . --max-warnings 0 --ignore-pattern 'packages/**'",
    "lint-fix": "eslint . --cache --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck-root",
    "typecheck-release": "turbo run typecheck-release",
    "typecheck-root": "tsc",
    "verify-changesets": "node scripts/verify-changesets.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.0"
  }
}
