{
  "name": "jslib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "pre-push": "run-p typecheck lint fmt-check && pnpm build && ./scripts/verify-no-git-changes.sh",
    "cs": "changeset && changeset version",
    "cs-publish": "run-p typecheck lint fmt-check && turbo run test && changeset publish && git tag | xargs -n 1 -I% git tag -d %",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && premove .turbo",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.css\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "stylelint \"**/*.css\" --fix",
    "fmt": "prettier \"**/*.{js,mjs,cjs,ts,jsx,tsx,css,json}\" --write",
    "fmt-check": "prettier \"**/*.{js,mjs,cjs,ts,jsx,tsx,css,json}\" --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@gpahal/eslint-config": "workspace:*",
    "@gpahal/prettier-config": "workspace:*",
    "@gpahal/stylelint-config": "workspace:*",
    "@gpahal/tsconfig": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "npm-run-all2": "^9.0.3",
    "premove": "^4.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "tsc-alias": "^1.9.1",
    "tsc-files": "^1.1.4",
    "tsup": "^8.5.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
