{
  "name": "@gpahal/font-fallback",
  "version": "0.0.61",
  "description": "Generates size-adjusted CSS font fallbacks from font metrics to reduce layout shift",
  "keywords": [
    "font",
    "font-fallback",
    "fallback-font",
    "size-adjust",
    "font-metrics",
    "cls",
    "layout-shift",
    "css",
    "web-performance"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/font-fallback#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/font-fallback"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "font-fallback": "./build/cli.js"
  },
  "files": [
    "src",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "lint-check": "eslint . --max-warnings 0",
    "prepublishOnly": "../../scripts/verify-publish-tool.sh",
    "test": "vitest run --config ../../vitest.config.ts --project 'tests*'",
    "test-canaries": "vitest run --config ../../vitest.config.ts --project canaries",
    "typecheck": "tsc && tsc -p tests",
    "typecheck-release": "tsc -p tsconfig.release.json && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@capsizecss/metrics": "^4.4.0",
    "@gpahal/std": "workspace:*",
    "fontkitten": "1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@gpahal/internal": "workspace:*",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
