{
  "name": "@gpahal/font-fallback",
  "version": "0.0.59",
  "description": "Generates size-adjusted CSS font fallbacks from font metrics to reduce layout shift",
  "keywords": [
    "font",
    "font-fallback",
    "fallback-font",
    "size-adjust",
    "font-metrics",
    "cls",
    "layout-shift",
    "css",
    "web-performance"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/font-fallback#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/font-fallback"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@capsizecss/metrics": "^4.3.0",
    "@capsizecss/unpack": "^4.0.1",
    "@gpahal/std": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
