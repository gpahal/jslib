{
  "name": "@gpahal/stylelint-config",
  "version": "0.0.29",
  "description": "Shared Stylelint config presets extending stylelint-config-standard, with a Tailwind CSS v4 variant",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "stylelintconfig",
    "css",
    "lint",
    "tailwindcss"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/stylelint-config#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/stylelint-config"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./tailwindcss": "./build/tailwindcss.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "lint-check": "eslint . --max-warnings 0",
    "prepublishOnly": "../../scripts/verify-publish-tool.sh",
    "test": "vitest run --project 'tests*'",
    "test-canaries": "vitest run --project canaries",
    "typecheck": "tsc && tsc -p tests",
    "typecheck-release": "tsc -p tsconfig.release.json && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@csstools/css-tokenizer": "^4.0.2",
    "@gpahal/std": "workspace:*",
    "brace-expansion": "^5.0.12",
    "cosmiconfig": "^10.0.1",
    "import-meta-resolve": "^4.2.0",
    "postcss": "^8.5.31",
    "postcss-html": "^2.0.0",
    "postcss-markdown": "^2.0.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-plugin-use-baseline": "^1.4.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gpahal/internal": "workspace:*",
    "@gpahal/prettier-config": "workspace:*",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "stylelint": "^17.15",
    "tailwindcss": "^4.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
