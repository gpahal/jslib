{
  "name": "@gpahal/stylelint-config",
  "version": "0.0.30",
  "description": "Shared Stylelint config presets extending stylelint-config-standard, with a Tailwind CSS v4 variant",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "stylelintconfig",
    "css",
    "lint",
    "tailwindcss"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/stylelint-config#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/stylelint-config"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./tailwindcss": "./build/tailwindcss.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "lint-check": "eslint . --max-warnings 0",
    "prepublishOnly": "../../scripts/verify-publish-tool.sh",
    "test": "vitest run --project 'tests*'",
    "test-canaries": "vitest run --project canaries",
    "typecheck": "tsc && tsc -p tests",
    "typecheck-release": "tsc -p tsconfig.release.json && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@csstools/css-tokenizer": "catalog:",
    "@gpahal/std": "workspace:*",
    "brace-expansion": "catalog:",
    "cosmiconfig": "catalog:",
    "import-meta-resolve": "catalog:",
    "postcss": "catalog:",
    "postcss-html": "catalog:",
    "postcss-markdown": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-plugin-use-baseline": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gpahal/internal": "workspace:*",
    "@gpahal/prettier-config": "workspace:*",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "stylelint": "^17.15",
    "tailwindcss": "^4.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
