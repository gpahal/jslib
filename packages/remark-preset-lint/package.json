{
  "name": "@gpahal/remark-preset-lint",
  "version": "0.0.8",
  "description": "Remark lint preset for Markdown and MDX, with GFM, math and frontmatter support",
  "keywords": [
    "remark",
    "remark-preset",
    "remark-lint",
    "markdown",
    "mdx",
    "gfm",
    "lint",
    "unified"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/remark-preset-lint#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/remark-preset-lint"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-checkbox-character-style": "^5.0.1",
    "remark-lint-file-extension": "^3.0.1",
    "remark-lint-list-item-indent": "^4.0.1",
    "remark-lint-maximum-heading-length": "^4.1.1",
    "remark-lint-maximum-line-length": "^4.1.1",
    "remark-lint-mdx-jsx-no-void-children": "^1.0.1",
    "remark-lint-mdx-jsx-quote-style": "^1.0.1",
    "remark-lint-mdx-jsx-self-close": "^1.0.1",
    "remark-lint-mdx-jsx-unique-attribute-name": "^1.0.1",
    "remark-lint-no-heading-punctuation": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-markdown-style-guide": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1"
  }
}
