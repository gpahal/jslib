    "eslint-plugin-slop": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "eslint-typegen": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
