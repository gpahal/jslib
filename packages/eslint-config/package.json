{
  "name": "@gpahal/eslint-config",
  "version": "0.0.136",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "import": "./build/*.js",
      "types": "./build/*.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "build/*.d.ts"
      ]
    }
  },
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@gpahal/std": "workspace:*",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.1",
    "@eslint/css": "^2.0.0",
    "@html-eslint/parser": "^0.66.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.2",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.20",
    "@eslint/css": "^2.0",
    "@html-eslint/parser": "^0.66",
    "@next/eslint-plugin-next": "^16.3",
    "@vitest/eslint-plugin": "^1.6",
    "eslint": "^10.11",
    "eslint-plugin-astro": "^3.2",
    "eslint-plugin-better-tailwindcss": "^4.7",
    "eslint-plugin-react-hooks": "^7.1",
    "eslint-plugin-turbo": "^2.11",
    "tailwind-csstree": "^0.4",
    "tailwindcss": "^4.3"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "@eslint/css": {
      "optional": true
    },
    "@html-eslint/parser": {
      "optional": true
    },
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-turbo": {
      "optional": true
    },
    "tailwind-csstree": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
