{
  "name": "@gpahal/eslint-config",
  "version": "0.0.146",
  "description": "Composable flat ESLint config for TypeScript, React, Next.js, Astro, Tailwind CSS, Node, HTML, Turbo, Vitest, Playwright, Storybook, JSON, YAML, TOML and Markdown",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "flat-config",
    "typescript",
    "react",
    "nextjs",
    "astro",
    "tailwindcss",
    "vitest",
    "lint",
    "yaml",
    "toml",
    "sonarjs",
    "jsdoc"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./eslint-comments": "./build/eslint-comments.js",
    "./slop": "./build/slop.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.gen.d.ts",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "gen": "tsdown && node scripts/typegen.ts && tsdown",
    "inspect": "eslint-config-inspector --config ../../eslint.config.mjs",
    "lint-check": "eslint . --max-warnings 0",
    "prepublishOnly": "../../scripts/verify-publish-tool.sh",
    "test": "vitest run --project 'tests*'",
    "test-canaries": "vitest run --project canaries",
    "typecheck": "tsc && tsc -p tests",
    "typecheck-release": "tsc -p tsconfig.release.json && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/js": "catalog:",
    "@eslint/json": "catalog:",
    "@eslint/markdown": "catalog:",
    "@gpahal/std": "workspace:*",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "brace-expansion": "catalog:",
    "collapse-white-space": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-markdown-preferences": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-toml": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-yml": "catalog:",
    "github-slugger": "catalog:",
    "globals": "catalog:",
    "hast-util-from-html": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-frontmatter": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-math": "catalog:",
    "mdast-util-to-string": "catalog:",
    "micromark-extension-frontmatter": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "micromark-extension-math": "catalog:",
    "micromark-util-normalize-identifier": "catalog:",
    "minimatch": "catalog:",
    "semver": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/config-inspector": "catalog:",
    "@gpahal/internal": "workspace:*",
    "@gpahal/prettier-config": "workspace:*",
    "@html-eslint/eslint-plugin": "catalog:",
    "@html-eslint/parser": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/estree": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/unist": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-jsx-a11y-x": "catalog:",
