{
  "name": "@gpahal/logger",
  "version": "0.0.31",
  "description": "Leveled application logger built on Winston",
  "keywords": [
    "logger",
    "logging",
    "log",
    "winston",
    "node",
    "typescript"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/logger#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/logger"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "logform": "^2.7.0"
  }
}
