    "@gpahal/std": "workspace:*",
    "@gpahal/stylelint-config": "workspace:*",
    "@gpahal/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.2",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.22.0"
  }
