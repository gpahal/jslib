{
  "name": "@gpahal/recipes",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end checks of the repository's setup recipes and test tasks, never published",
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "type": "module",
  "scripts": {
    "lint-check": "eslint . --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --project 'tests*' tests/test-selection.test.ts",
    "test-recipes": "vitest run --config ../../vitest.config.ts --project tests --test-timeout 600000 tests/setup-recipes.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@gpahal/eslint-config": "workspace:*",
    "@gpahal/internal": "workspace:*",
    "@gpahal/prettier-config": "workspace:*",
    "@gpahal/std": "workspace:*",
    "@gpahal/stylelint-config": "workspace:*",
    "@gpahal/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "astro": "catalog:",
    "next": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
