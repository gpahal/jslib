{
  "name": "@gpahal/recipes",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end checks of the repository's setup recipes and test tasks, never published",
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "type": "module",
  "scripts": {
    "lint-check": "eslint . --max-warnings 0",
