{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // `tests/test-selection.test.ts` lists the test files of every package's `test` and
    // `test-canaries` scripts, which pick them by Vitest project. It checks only where the canaries
    // go, so the other test files don't change its result
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/vitest.config.ts",
        "$TURBO_ROOT$/packages/*/tests/**/*.canary.test.ts"
      ]
    },
    // `tests/setup-recipes.test.ts`, which the slow child processes of every setup recipe of the
    // repository README make a task of its own. Its projects get the builds of the packages the
    // recipes install, which `^build` hashes, and tsconfig's presets, which have no build. Its
    // script sets a 10-minute test timeout, since under `pnpm check`, or on a 4-vCPU CI runner, a
    // recipe can take about 3 minutes, past the root limit
    "test-recipes": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "tests/setup-recipes.test.ts",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/packages/tsconfig/*.json"
      ]
    }
  }
}
