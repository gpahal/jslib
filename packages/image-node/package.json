{
  "name": "@gpahal/image-node",
  "version": "0.0.65",
  "description": "Sharp-backed image buffer transformer implementing the @gpahal/image transform interface",
  "keywords": [
    "image",
    "images",
    "sharp",
    "image-processing",
    "image-transform",
    "resize",
    "node"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/image-node#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/image-node"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@gpahal/image": "workspace:*"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "sharp": "^0.35"
  }
}
