{
  "name": "@gpahal/tailwindcss-color-themes",
  "version": "0.0.49",
  "description": "Generates Tailwind CSS color theme variables from a theme config",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwindcss-plugin",
    "color-themes",
    "themes",
    "theming",
    "dark-mode",
    "css-variables",
    "colors"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/tailwindcss-color-themes#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/tailwindcss-color-themes"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@gpahal/std": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3"
  }
}
