{
  "name": "@gpahal/std-node",
  "version": "0.0.48",
  "description": "Node-only companion to @gpahal/std, with filesystem and process utilities",
  "keywords": [
    "std",
    "stdlib",
    "utilities",
    "utils",
    "node",
    "fs",
    "filesystem",
    "process",
    "typescript"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/std-node#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/std-node"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "import": "./build/*.js",
      "types": "./build/*.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "build/*.d.ts"
      ]
    }
  },
  "files": [
    "package.json",
    "README.md",
    "src",
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@gpahal/std": "workspace:*",
    "why-is-node-running": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
