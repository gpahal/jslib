{
  "name": "@gpahal/og-image",
  "version": "0.0.59",
  "description": "Open Graph image generation from HTML via Satori, with a separate WASM entry point for edge runtimes",
  "keywords": [
    "og-image",
    "open-graph",
    "opengraph",
    "social-image",
    "satori",
    "wasm",
    "edge",
    "image-generation"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/og-image#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/og-image"
  },
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./wasm": {
      "import": "./build/wasm.js",
      "types": "./build/wasm.d.ts"
    }
  },
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "package.json",
    "README.md",
    "src",
    "build",
    "wasm.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "premove build .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "satori": "^0.33.4",
    "satori-html": "^0.3.2",
    "yoga-wasm-web": "^0.3.3"
  },
  "devDependencies": {
    "@gpahal/font": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/node": "^26.6.2"
  }
}
