{
  "name": "@gpahal/prettier-config",
  "version": "0.0.46",
  "description": "Shared Prettier config with sorted imports and package.json keys, and optional Astro and Tailwind CSS support",
  "keywords": [
    "prettier",
    "prettier-config",
    "prettierconfig",
    "formatting",
    "sort-imports",
    "astro",
    "tailwindcss"
  ],
  "homepage": "https://github.com/gpahal/jslib/tree/main/packages/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/gpahal/jslib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpahal/jslib.git",
    "directory": "packages/prettier-config"
  },
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "lint-check": "eslint . --max-warnings 0",
    "prepublishOnly": "../../scripts/verify-publish-tool.sh",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc && tsc -p tests",
    "typecheck-release": "tsc -p tsconfig.release.json && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@gpahal/std": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gpahal/internal": "workspace:*",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "prettier": "^3.9",
    "prettier-plugin-astro": "^1.1",
    "prettier-plugin-tailwindcss": ">=0.8.0 <0.9.0"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
