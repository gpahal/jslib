{
  "name": "@gpahal/internal",
  "version": "0.0.0",
  "private": true,
  "description": "Code shared by the @gpahal packages and bundled into each, never published",
  "license": "MIT",
  "author": "Garvit Pahal <g10pahal@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./comments": "./build/comments.js",
    "./globs": "./build/globs.js",
    "./node/cli": "./build/node/cli.js",
    "./node/json": "./build/node/json.js",
    "./node/options": "./build/node/options.js",
    "./node/package-manager": "./build/node/package-manager.js",
    "./node/paths": "./build/node/paths.js",
    "./node/resolve": "./build/node/resolve.js",
    "./node/root": "./build/node/root.js",
    "./node/source-maps": "./build/node/source-maps.js",
    "./node/testing": "./build/node/testing.js",
    "./node/versions": "./build/node/versions.js",
    "./node/zod": "./build/node/zod.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint-check": "eslint . --max-warnings 0",
    "test": "vitest run --config ../../vitest.config.ts --project 'tests*'",
    "typecheck": "tsc -p tsconfig.browser.json && tsc && tsc -p tests"
  },
  "dependencies": {
    "@gpahal/std": "workspace:*",
    "@types/node": "^24.19.2",
    "brace-expansion": "^5.0.12",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
